- ตารางพยากรณ์อากาศ 7 วันข้างหน้า (รวมผลจาก ECMWF, GFS, ICON และคำนวณกฎปลอดฝน 48 ชม. แล้ว):
${forecastSummary}

คำถามจากเจ้าของสวน: "${userQuestion}"

ช่วยวิเคราะห์และให้คำแนะนำแบบเจาะจงตามสภาพอากาศจริงด้านบนนี้เลยครับ`;

            try {
                const reply = await callGeminiWithBackoff(fullPrompt, systemInstruction);
                resText.textContent = reply;
            } catch (error) {
                resText.textContent = "ขออภัย ระบบเชื่อมต่อ AI ขัดข้องชั่วคราว แต่คุณสามารถดูวันฉีดยาที่แม่นยำได้จากปฏิทินด้านบน (แนะนำวันสีเขียวที่ปลอดฝน 2 วันติดครับ)";
            } finally {
                sendBtn.disabled = false;
                sendBtn.innerHTML = `<i data-lucide="send" class="w-4 h-4"></i><span>ถาม AI</span>`;
                lucide.createIcons();
            }
        }

        async function callGeminiWithBackoff(userQuery, systemPrompt) {
            const apiKey = ""; // Canvas provides key at runtime
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                }
            };

            const delays = [1000, 2000, 4000, 8000];
            for (let attempt = 0; attempt <= delays.length; attempt++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const result = await response.json();
                    const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (text) return text;
                    throw new Error("Empty response");
                } catch (err) {
                    if (attempt === delays.length) throw err;
                    await new Promise(resolve => setTimeout(resolve, delays[attempt]));
                }
            }
        }
    </script>
