    <script>
        // ==========================================
        // STATE & CONFIGURATION (Default: อ.ท่าชนะ จ.สุราษฎร์ธานี)
        // ==========================================
        let currentLat = 9.5736;
        let currentLon = 99.1672;
        let currentLocationName = "อ.ท่าชนะ จ.สุราษฎร์ธานี (คลองพา / ประสงค์)";
        let forecastDaysData = []; // Processed 10-day combined forecast
        let hourlyRawData = null;  // Hourly forecast for drill-down
        let selectedDayIndex = 0;  // Currently inspected day in UI
        let bestSprayDayIndex = 0; // Best recommended day overall
        let calendarViewMode = 'table'; // 'table' (default detailed) or 'cards'
        let lastThaiGroundedLocation = ''; // Cache key for Thai search grounding

        // Real-Time Auto-Refresh & Radar Map State
        let secondsUntilRefresh = 300; // Auto-refresh every 5 minutes (300s)
        let countdownTimerId = null;
        let radarMap = null;
        let radarMarker = null;
        let radarLayers = [];
        let radarFrames = [];
        let currentRadarFrameIdx = 0;
        let radarAnimInterval = null;
        let isRadarPlaying = false;

        const THAI_DAYS = ['อาทิตย์', 'จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์', 'เสาร์'];
        const THAI_MONTHS = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

        // Initialize on Window Load
        window.onload = function() {
            lucide.createIcons();
            updateMixCalculator();
            fetchWeatherData();
            startRealtimeAutoRefreshLoop();
        };

        // ==========================================
        // REAL-TIME TELEMETRY & AUTO-REFRESH TIMER
        // ==========================================
        function updateLiveTelemetryUI(current) {
            const locTitle = document.getElementById('liveLocationTitle');
            const condEl = document.getElementById('liveCurrentCondition');
            const rainEl = document.getElementById('liveRainRate');
            const tempHumidEl = document.getElementById('liveTempHumid');
            const windEl = document.getElementById('liveWindSpeed');
            const updatedEl = document.getElementById('lastUpdatedTime');
            const pulseBox = document.getElementById('liveRainPulseBox');
            const mobileLabel = document.getElementById('dataSourceMobile');

            if (locTitle) locTitle.textContent = currentLocationName;
            if (mobileLabel) {
                const shortLoc = currentLocationName.includes('ท่าชนะ') ? 'LIVE ท่าชนะ' : 'LIVE สวนฉัน';
                mobileLabel.textContent = shortLoc;
            }

            const now = new Date();
            const timeStr = now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            if (updatedEl) updatedEl.textContent = `อัปเดตล่าสุด: ${timeStr} น.`;

            if (!current) return;
            const precip = Number((current.precipitation ?? current.rain ?? 0).toFixed(1));
            const temp = Math.round(current.temperature_2m ?? 30);
            const humid = Math.round(current.relative_humidity_2m ?? 78);
            const wind = Math.round(current.wind_speed_10m ?? 10);

            if (rainEl) rainEl.textContent = `${precip} มม.`;
            if (tempHumidEl) tempHumidEl.textContent = `${temp}° / ${humid}%`;
            if (windEl) windEl.textContent = `${wind} กม./ชม.`;

            if (precip > 0.2) {
                if (condEl) condEl.textContent = `🌧️ ขณะนี้มีฝนตกในพื้นที่ (${precip} มม./ชม.) — งดฉีดพ่น`;
                if (pulseBox) pulseBox.className = "w-12 h-12 rounded-2xl bg-rose-500/25 border border-rose-400/50 text-rose-300 flex items-center justify-center shrink-0";
            } else {
                if (condEl) condEl.textContent = `☀️ ขณะนี้หน้าสวนไม่มีฝนตก (ท้องฟ้าแห้งพร้อมตรวจเช็ก)`;
                if (pulseBox) pulseBox.className = "w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 flex items-center justify-center shrink-0";
            }
        }

        function startRealtimeAutoRefreshLoop() {
            if (countdownTimerId) clearInterval(countdownTimerId);
            secondsUntilRefresh = 300;
            countdownTimerId = setInterval(() => {
                secondsUntilRefresh--;
                if (secondsUntilRefresh <= 0) {
                    secondsUntilRefresh = 300;
                    fetchWeatherData(true);
                }
                const mins = String(Math.floor(secondsUntilRefresh / 60)).padStart(2, '0');
                const secs = String(secondsUntilRefresh % 60).padStart(2, '0');
                const el = document.getElementById('autoRefreshCountdown');
                if (el) el.textContent = `• รีเฟรชอัตโนมัติใน ${mins}:${secs}`;
            }, 1000);
        }

        // Switch between Detailed Table View & Card View
        function setCalendarView(mode) {
            calendarViewMode = mode;
            const tableDiv = document.getElementById('detailedTableView');
            const cardsDiv = document.getElementById('tenDayGrid');
            const tableBtn = document.getElementById('viewTableBtn');
            const cardsBtn = document.getElementById('viewCardsBtn');

            if (mode === 'table') {
                tableDiv.classList.remove('hidden');
                cardsDiv.classList.add('hidden');
                tableBtn.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-durian-700 text-white shadow-sm transition flex items-center gap-1.5 cursor-pointer";
                cardsBtn.className = "px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5 cursor-pointer";
            } else {
