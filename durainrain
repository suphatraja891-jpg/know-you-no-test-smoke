        function showRadarFrame(idx) {
            if (!radarLayers.length) return;
            radarLayers.forEach((l, i) => l.setOpacity(i === idx ? 0.68 : 0));
            currentRadarFrameIdx = idx;

            const frame = radarFrames[idx];
            if (frame) {
                const d = new Date(frame.time * 1000);
                const tStr = d.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                const isForecast = frame.time * 1000 > Date.now();
                document.getElementById('radarTimestampBadge').textContent = isForecast
                    ? `คาดการณ์ล่วงหน้า ${tStr} น.`
                    : `ภาพเรดาร์สด ${tStr} น.`;
            }
