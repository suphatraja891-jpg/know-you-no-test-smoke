        function renderHourlyBlocks(dateStr) {
            const strip = document.getElementById('hourlyStrip');
            strip.innerHTML = '';

            const dayHours = hourlyRawData.filter(h => h.time.startsWith(dateStr));
            // Show key farming hours from 06:00 to 19:00 (every 1 hour -> 14 blocks, 7x2 grid)
            const workingHours = dayHours.filter(h => {
                const hr = parseInt(h.time.split('T')[1].split(':')[0], 10);
                return hr >= 6 && hr <= 19;
            });

            workingHours.forEach(h => {
                const hrStr = h.time.split('T')[1].slice(0, 5);
                const hrNum = parseInt(hrStr.split(':')[0], 10);

                // Determine if this specific hour is optimal for spraying
                const isRainy = h.rain >= 0.3 || h.prob > 40;
                const isWindy = h.wind > 16;
                const isTooHot = h.temp >= 35;
                const isIdealStomata = (hrNum >= 6 && hrNum <= 10) || (hrNum >= 16 && hrNum <= 18);

                let boxClass = "bg-slate-50 border-slate-200";
                let tagHTML = `<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-200 text-slate-700">พอฉีดได้</span>`;
                let iconName = "cloud";
                let iconColor = "text-slate-500";

                if (isRainy) {
                    boxClass = "bg-rose-50 border-rose-200";
                    tagHTML = `<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-rose-500 text-white">ฝนตก/เสี่ยง</span>`;
                    iconName = "cloud-rain";
                    iconColor = "text-rose-500";
                } else if (isWindy) {
                    boxClass = "bg-amber-50 border-amber-200";
                    tagHTML = `<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-500 text-white">ลมแรงปลิว</span>`;
                    iconName = "wind";
                    iconColor = "text-amber-600";
                } else if (isTooHot) {
                    boxClass = "bg-orange-50 border-orange-200";
                    tagHTML = `<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-orange-500 text-white">ร้อนปากใบปิด</span>`;
                    iconName = "sun";
                    iconColor = "text-orange-500";
                } else if (isIdealStomata) {
                    boxClass = "bg-emerald-50 border-emerald-400 ring-1 ring-emerald-400/40";
                    tagHTML = `<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-600 text-white">✨ นาทีทอง</span>`;
                    iconName = "sun";
                    iconColor = "text-amber-500";
                }

                const blockHTML = `
                    <div class="rounded-2xl p-3 border ${boxClass} flex flex-col justify-between space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-slate-800">${hrStr} น.</span>
                            <i data-lucide="${iconName}" class="w-4 h-4 ${iconColor}"></i>
                        </div>
                        <div class="space-y-0.5 text-[11px] text-slate-600">
                            <div class="flex justify-between">
                                <span>ฝน:</span>
                                <span class="font-bold ${h.rain > 0 ? 'text-rose-600' : 'text-slate-800'}">${h.rain} มม. (${h.prob}%)</span>
                            </div>
                            <div class="flex justify-between">
                                <span>ลม/อุณหภูมิ:</span>
                                <span class="font-semibold">${h.wind}กม. / ${h.temp}°</span>
                            </div>
                        </div>
                        <div class="pt-1 text-center">
                            ${tagHTML}
                        </div>
                    </div>
                `;
                strip.insertAdjacentHTML('beforeend', blockHTML);
            });
        }

