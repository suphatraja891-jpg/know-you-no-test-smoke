                const rvData = await rvRes.json();
                const pastFrames = rvData?.radar?.past || [];
                const nowcastFrames = rvData?.radar?.nowcast || [];
                radarFrames = [...pastFrames.slice(-5), ...nowcastFrames.slice(0, 3)];

                // Clear old radar layers
                radarLayers.forEach(layer => radarMap.removeLayer(layer));
                radarLayers = [];

                if (radarFrames.length > 0) {
                    radarFrames.forEach((frame, idx) => {
                        const tileUrl = `${rvData.host}${frame.path}/256/{z}/{x}/{y}/2/1_1.png`;
                        const layer = L.tileLayer(tileUrl, {
                            opacity: 0,
                            zIndex: 200 + idx
                        });
                        layer.addTo(radarMap);
                        radarLayers.push(layer);
